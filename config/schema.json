{
  "schema_version": 1,
  "config_version_key": "HIDDEN_GIT_CONFIG_VERSION",
  "current_config_version": "2",
  "internal": {
    "soft_serve_data_path": "/var/lib/soft-serve",
    "soft_serve_ssh_port": 23231,
    "soft_serve_http_port": 23232,
    "soft_serve_stats_port": 23233,
    "soft_serve_git_port": 9418,
    "tor_target_port": 23231,
    "ci": "1"
  },
  "keys": {
    "HIDDEN_GIT_CONFIG_VERSION": {"kind": "schema", "type": "const", "value": "2", "required": true},
    "SOFT_SERVE_NAME": {"kind": "user-intent", "type": "nonempty", "required": true},
    "SOFT_SERVE_INITIAL_ADMIN_KEYS": {"kind": "bootstrap-only", "type": "optional", "required": true, "secret": true},
    "ONION_PUBLIC_PORT": {"kind": "user-intent", "type": "port", "required": true},
    "LOCAL_SSH_PORT": {"kind": "user-intent", "type": "port", "required": true},
    "HOST_BIND_ADDRESS": {"kind": "advanced-override", "type": "bind-address", "required": true},
    "SOFT_SERVE_SSH_PUBLIC_URL": {"kind": "advanced-override", "type": "optional-ssh-url", "required": true},
    "SOFT_SERVE_SSH_USER": {"kind": "diagnostic", "type": "nonempty", "required": true},
    "CHECK_TIMEOUT_SECONDS": {"kind": "diagnostic", "type": "positive-integer", "required": true},
    "BACKUP_RECIPIENT": {"kind": "recovery", "type": "optional", "required": true}
  },
  "release_keys": {
    "ALPINE_IMAGE": {"kind": "release", "type": "image-digest", "required": true},
    "GO_IMAGE": {"kind": "release", "type": "image-digest", "required": true},
    "SOFT_SERVE_VERSION": {"kind": "release", "type": "version-tag", "required": true},
    "ONION_SSH_PORT": {"kind": "runtime-policy", "type": "const", "value": "2022", "required": true},
    "TRIVY_IMAGE": {"kind": "release", "type": "image-digest", "required": true},
    "BUILDKIT_IMAGE": {"kind": "release", "type": "image-digest", "required": true},
    "DIND_ROOTLESS_IMAGE": {"kind": "release", "type": "image-digest", "required": true}
  },
  "legacy_keys": {
    "HIDDEN_GIT_VERSION": {"action": "drop-release-owned"},
    "ALPINE_IMAGE": {"action": "drop-release-owned"},
    "GO_IMAGE": {"action": "drop-release-owned"},
    "SOFT_SERVE_VERSION": {"action": "drop-release-owned"},
    "TRIVY_IMAGE": {"action": "drop-release-owned"},
    "BUILDKIT_IMAGE": {"action": "drop-release-owned"},
    "DIND_ROOTLESS_IMAGE": {"action": "drop-release-owned"},
    "BACKUP_IDENTITY_FILE": {"action": "drop-recovery-identity", "secret": true},
    "SOFT_SERVE_SSH_PORT": {"action": "map-local-ssh", "default": "23231"},
    "SOFT_SERVE_HTTP_PORT": {"action": "retire-auxiliary-topology", "default": "23232"},
    "SOFT_SERVE_STATS_PORT": {"action": "retire-auxiliary-topology", "default": "23233"},
    "SOFT_SERVE_GIT_PORT": {"action": "retire-auxiliary-topology", "default": "9418"},
    "ONION_TARGET_PORT": {"action": "validate-and-drop-target", "default": "23231"},
    "SOFT_SERVE_DATA_PATH": {"action": "validate-and-drop-constant", "default": "/var/lib/soft-serve"},
    "CI": {"action": "validate-and-drop-constant", "default": "1"},
    "SOFT_SERVE_HTTP_PUBLIC_URL": {"action": "retire-auxiliary-topology", "default": "http://localhost:23232"},
    "SOFT_SERVE_GIT_PUBLIC_URL": {"action": "retire-auxiliary-topology", "default": "git://localhost:9418"},
    "DEBIAN_IMAGE": {"action": "drop-retired-release-key", "default": ""}
  }
}
