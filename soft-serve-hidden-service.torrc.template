# Hidden service identity and hostname are persisted under /var/lib/tor.
DataDirectory /var/lib/tor
HiddenServiceDir /var/lib/tor/hidden_service/
PidFile /run/hidden-git/tor.pid
Log notice stdout
ControlPort 127.0.0.1:9051
CookieAuthentication 1
CookieAuthFile /run/hidden-git/control_auth_cookie

# Port 2022 is a release-managed HiddenGit SSH endpoint. The compatibility line
# is generated only when ONION_PUBLIC_PORT differs, so one virtual port can never
# be declared twice. Both lines share this one persisted HiddenServiceDir.
HiddenServicePort ${ONION_SSH_PORT} soft-serve:23231
${ONION_COMPAT_HIDDEN_SERVICE_PORT}
