# HiddenGit operator configuration schema. Migrate older files with:
#   ./run.sh config migrate
#   ./run.sh config migrate --apply
HIDDEN_GIT_CONFIG_VERSION=2

# ---- Deployment intent ----
SOFT_SERVE_NAME=HiddenGit
# Bootstrap-only. Required only while creating the first Soft Serve database.
# Once a database exists, HiddenGit suppresses this value from the Soft Serve
# process environment even if an established .env still contains a stale key.
# Clear it after bootstrap. Paste public keys only, never private keys.
SOFT_SERVE_INITIAL_ADMIN_KEYS=

# Tor-facing virtual SSH port. The backend target is fixed at soft-serve:23231.
ONION_PUBLIC_PORT=8002

# Local operator SSH publication. This host port maps to fixed internal 23231.
LOCAL_SSH_PORT=23231
HOST_BIND_ADDRESS=127.0.0.1

# Optional clone metadata only. Empty derives ssh://localhost:<LOCAL_SSH_PORT>.
# A valid explicit ssh:// URL is preserved independently of every routing port.
SOFT_SERVE_SSH_PUBLIC_URL=

# ---- Runtime diagnostics ----
SOFT_SERVE_SSH_USER=admin
CHECK_TIMEOUT_SECONDS=180

# ---- Encrypted recovery ----
# Public age recipient only. Keep the corresponding identity offline and pass
# its path explicitly to verify-backup/restore.
BACKUP_RECIPIENT=
