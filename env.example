# ---- Base images / toolchain versions ----
HIDDEN_GIT_VERSION=0.0.2
# Debian 13 (trixie).
DEBIAN_IMAGE=debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd
# Go image tag for building soft-serve binary.
GO_IMAGE=golang:1.26.5-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651
SOFT_SERVE_VERSION=v0.11.6
# Downstream security-only dependency overrides for the pinned Soft Serve release.
SOFT_SERVE_WISH_VERSION=v2.0.1
SOFT_SERVE_GO_GIT_VERSION=v5.19.0
SOFT_SERVE_GO_JOSE_VERSION=v3.0.5
SOFT_SERVE_X_CRYPTO_VERSION=v0.52.0
SOFT_SERVE_X_NET_VERSION=v0.55.0
TRIVY_IMAGE=aquasec/trivy:0.72.0@sha256:cffe3f5161a47a6823fbd23d985795b3ed72a4c806da4c4df16266c02accdd6f
BUILDKIT_IMAGE=moby/buildkit:buildx-stable-1@sha256:2f5adac4ecd194d9f8c10b7b5d7bceb5186853db1b26e5abd3a657af0b7e26ec

# ---- Service ports ----
SOFT_SERVE_SSH_PORT=23231
SOFT_SERVE_HTTP_PORT=23232
SOFT_SERVE_STATS_PORT=23233
SOFT_SERVE_GIT_PORT=9418
ONION_TARGET_PORT=23231

# Tor hidden service mapping (onion public port -> soft-serve internal SSH port)
ONION_PUBLIC_PORT=8002

# ---- Runtime behavior ----
SOFT_SERVE_DATA_PATH=/var/lib/soft-serve
SOFT_SERVE_NAME=HiddenGit
# Required on first boot. Paste one or more complete SSH public keys.
SOFT_SERVE_INITIAL_ADMIN_KEYS=
CI=1

# Host-published ports stay local unless this is explicitly changed.
HOST_BIND_ADDRESS=127.0.0.1

# URLs displayed by Soft Serve in clone instructions.
SOFT_SERVE_SSH_PUBLIC_URL=ssh://localhost:23231
SOFT_SERVE_HTTP_PUBLIC_URL=http://localhost:23232
SOFT_SERVE_GIT_PUBLIC_URL=git://localhost:9418

# SSH user for readiness checks in run.sh
SOFT_SERVE_SSH_USER=admin

# Maximum duration of a containerized onion SSH probe.
CHECK_TIMEOUT_SECONDS=180

# ---- Encrypted backups ----
# Public age recipient only. Keep the corresponding identity offline.
BACKUP_RECIPIENT=
# Optional local default used by './run.sh restore'. Never commit this file.
BACKUP_IDENTITY_FILE=
