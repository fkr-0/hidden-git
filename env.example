# ---- Base images / toolchain versions ----
# Debian 13 (trixie) stable as of 2026-05-26.
DEBIAN_IMAGE=debian:trixie-slim
# Go image tag for building soft-serve binary.
GO_IMAGE=golang:1.26.3-bookworm
SOFT_SERVE_VERSION=v0.11.6

# ---- Service ports ----
# do not change me until someone wires up data/soft-serve/config.yaml
ONION_TARGET_PORT=23231 # route onion port to this soft-serve-container port
SOFT_SERVE_SSH_PORT=23231 # serve SSH on this port in the container (actually configured in config.yaml...)
SOFT_SERVE_HTTP_PORT=23232 # entirely..
SOFT_SERVE_STATS_PORT=23233 # ..untested
SOFT_SERVE_GIT_PORT=9418 # same.
# do not change me until someone wires up data/soft-serve/config.yaml
# ---- Service ports end ----


# Tor hidden service mapping (onion public port -> soft-serve internal SSH port)
ONION_PUBLIC_PORT=8002

# ---- Runtime behavior ----
SOFT_SERVE_DATA_PATH=/var/lib/soft-serve
SOFT_SERVE_INITIAL_ADMIN_KEYS= # yes i was not tested as well
CI=1

# SSH user for readiness checks in run.sh
SOFT_SERVE_SSH_USER=admin
