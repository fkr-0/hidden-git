# HiddenGit deployment configuration schema. Migrate older files with:
#   ./run.sh config migrate
#   ./run.sh config migrate --apply
HIDDEN_GIT_CONFIG_VERSION=1

# ---- Release-managed inputs ----
# These values are reviewed as one release set. Use ./run.sh sync-pins rather
# than editing them individually during normal deployment administration.
HIDDEN_GIT_VERSION=0.1.1
ALPINE_IMAGE=alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40
GO_IMAGE=golang:1.26.7-bookworm@sha256:e8c859f5632dcfde7b32d2012b4351728f6437930887c2f6a91ea242459e5514
SOFT_SERVE_VERSION=v0.12.2
# Explicit dependency versions mirror the reviewed upstream v0.12.2 graph.
SOFT_SERVE_WISH_VERSION=v2.0.3
SOFT_SERVE_GO_GIT_VERSION=v5.19.2
SOFT_SERVE_GO_JOSE_VERSION=v3.0.5
SOFT_SERVE_X_CRYPTO_VERSION=v0.54.0
SOFT_SERVE_X_NET_VERSION=v0.57.0
TRIVY_IMAGE=aquasec/trivy:0.72.0@sha256:cffe3f5161a47a6823fbd23d985795b3ed72a4c806da4c4df16266c02accdd6f
BUILDKIT_IMAGE=moby/buildkit:buildx-stable-1@sha256:2f5adac4ecd194d9f8c10b7b5d7bceb5186853db1b26e5abd3a657af0b7e26ec
DIND_ROOTLESS_IMAGE=docker:29.6.1-dind-rootless@sha256:371962f4344295a1eb185f1c9e62064bf4503a7beb8c6e73be3405500041784b

# ---- Deployment intent ----
SOFT_SERVE_NAME=HiddenGit
# Bootstrap-only. Required only while creating the first Soft Serve database.
# Leave empty on established deployments unless deliberately bootstrapping a
# fresh state tree. Paste one or more complete SSH public keys, never private keys.
SOFT_SERVE_INITIAL_ADMIN_KEYS=

# Remote Tor endpoint. The internal Tor target is intentionally fixed to the
# managed Soft Serve SSH listener and is no longer independently configurable.
ONION_PUBLIC_PORT=8002

# Local operator SSH publication. This host port maps to the fixed internal
# Soft Serve SSH port 23231. HTTP, native git:// and stats are not host-published
# by the default profile.
LOCAL_SSH_PORT=23231
HOST_BIND_ADDRESS=127.0.0.1

# Optional clone-hint override. Empty derives ssh://localhost:<LOCAL_SSH_PORT>.
# Set an explicit ssh:// URL only when the public endpoint intentionally differs
# (for example a documented proxy or post-bootstrap onion clone hint).
SOFT_SERVE_SSH_PUBLIC_URL=

# ---- Runtime diagnostics ----
SOFT_SERVE_SSH_USER=admin
CHECK_TIMEOUT_SECONDS=180

# ---- Encrypted recovery ----
# Public age recipient only. Keep the corresponding identity offline.
BACKUP_RECIPIENT=
# Optional local default used by './run.sh restore'. Never commit this file.
BACKUP_IDENTITY_FILE=
