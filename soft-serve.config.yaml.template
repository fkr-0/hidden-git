name: "${SOFT_SERVE_NAME}"

log:
  format: "text"
  time_format: "2006-01-02 15:04:05"

# HiddenGit owns the internal network topology. Operator-facing host/onion ports
# are mapped to this stable SSH listener rather than changing the listener itself.
ssh:
  enabled: true
  listen_addr: ":23231"
  public_url: "${SOFT_SERVE_SSH_PUBLIC_URL}"
  key_path: "/var/lib/soft-serve/ssh/soft_serve_host_ed25519"
  client_key_path: "/var/lib/soft-serve/ssh/soft_serve_client_ed25519"
  max_timeout: 0
  idle_timeout: 600

# The unauthenticated native git:// daemon is outside HiddenGit's Tor+SSH product
# contract and is disabled by default.
git:
  enabled: false
  listen_addr: "127.0.0.1:9418"
  public_url: ""
  max_timeout: 0
  idle_timeout: 3
  max_connections: 32

# The default HiddenGit profile is SSH-only. HTTP can be reintroduced only by a
# reviewed product change or explicit Compose/config override with a threat model.
http:
  enabled: false
  listen_addr: "127.0.0.1:23232"
  tls_key_path: ""
  tls_cert_path: ""
  public_url: ""

# Keep process statistics available only inside the Soft Serve container.
stats:
  enabled: true
  listen_addr: "127.0.0.1:23233"

db:
  driver: "sqlite"
  data_source: "/var/lib/soft-serve/soft-serve.db?_pragma=busy_timeout(5000)&_pragma=foreign_keys(1)"

# LFS is disabled in the SSH-only profile. It is not silently exposed through an
# HTTP listener, and SSH LFS remains off unless a future reviewed design enables it.
lfs:
  enabled: false
  ssh_enabled: false

jobs:
  mirror_pull: "@every 10m"
