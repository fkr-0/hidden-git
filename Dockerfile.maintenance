ARG DEBIAN_IMAGE=debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd
FROM ${DEBIAN_IMAGE}

RUN DEBIAN_FRONTEND=noninteractive apt-get update && \
    apt-get install -y --no-install-recommends age ca-certificates coreutils tar tini && \
    rm -rf /var/lib/apt/lists/*

COPY --chmod=0755 scripts/maintenance.sh /usr/local/bin/hidden-git-maintenance

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hidden-git-maintenance"]
