ARG ALPINE_IMAGE=alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40
FROM ${ALPINE_IMAGE}

RUN apk upgrade --no-cache && \
    apk add --no-cache age bash ca-certificates coreutils tar tini

COPY --chmod=0755 scripts/maintenance.sh /usr/local/bin/hidden-git-maintenance

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/hidden-git-maintenance"]
