ARG DEBIAN_IMAGE=debian:bookworm-slim
FROM ${DEBIAN_IMAGE}

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates tor tini && \
    rm -rf /var/lib/apt/lists/*

COPY ./soft-serve-hidden-service.torrc /etc/tor/torrc
VOLUME ["/var/lib/tor"]

ENTRYPOINT ["/usr/bin/tini", "--", "tor", "-f", "/etc/tor/torrc"]
