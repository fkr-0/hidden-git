ARG DEBIAN_IMAGE=debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd
FROM ${DEBIAN_IMAGE}

RUN DEBIAN_FRONTEND=noninteractive apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates tor tini gettext-base && \
    rm -rf /var/lib/apt/lists/* && \
    printf 'hidden-tor:x:10002:\n' >> /etc/group && \
    printf 'hidden-tor:x:10002:10002:HiddenGit Tor service:/var/lib/tor:/usr/sbin/nologin\n' >> /etc/passwd && \
    install -d -o 10002 -g 10002 -m 0700 /var/lib/tor /run/hidden-git

COPY ./soft-serve-hidden-service.torrc.template /etc/tor/torrc.template
COPY --chmod=0755 scripts/tor-entrypoint.sh /usr/local/bin/hidden-git-tor-entrypoint
COPY --chmod=0755 scripts/tor-healthcheck.sh /usr/local/bin/hidden-git-tor-healthcheck
VOLUME ["/var/lib/tor"]
USER 10002:10002

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hidden-git-tor-entrypoint"]
